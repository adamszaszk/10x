---
import { Map, Calendar, Sparkles, Shield, Globe, Heart } from "lucide-react";

interface Props {
  title: string;
  description: string;
  icon: "map" | "calendar" | "sparkles" | "shield" | "globe" | "heart";
}

const { title, description, icon } = Astro.props;

const iconMap = {
  map: Map,
  calendar: Calendar,
  sparkles: Sparkles,
  shield: Shield,
  globe: Globe,
  heart: Heart,
};

const IconComponent = iconMap[icon];
---

<div
  class="flex flex-col items-center text-center p-6 bg-white dark:bg-stone-900 rounded-lg shadow-sm border border-stone-200 dark:border-stone-800 transition-all hover:shadow-md"
>
  <div class="p-3 bg-primary/10 rounded-full mb-4 text-primary">
    {IconComponent && <IconComponent className="w-8 h-8" />}
  </div>
  <h3 class="text-xl font-semibold mb-2 text-stone-900 dark:text-stone-100">{title}</h3>
  <p class="text-stone-600 dark:text-stone-400 leading-relaxed">{description}</p>
</div>
